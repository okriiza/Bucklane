{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bucklane",
  "version": "0.5.1",
  "identifier": "app.bucklane.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bucklane",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NjE2Mjk2MjgzNUM1QzQKUldURXhUVW9sbUpodGNzNnlWMzI0akhSbmI0VGhQUmtmTTJGRU5qc0o0SnZFbmZRcGNmcjBkc2kK",
      "endpoints": [
        "https://github.com/okriiza/Bucklane/releases/latest/download/latest.json"
      ]
    }
  }
}
